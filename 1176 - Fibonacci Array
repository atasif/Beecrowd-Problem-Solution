int main()
{

    int n,i,k;
    long long int array[60];
    array[0]=0;
    array[1]=1;
    for (i=2;i<=60;i++){
        array[i]=array[i-1]+array[i-2];
    }
    scanf("%d",&n);

    for(i=0;i<n;i++){
        scanf("%d",&k);
printf("Fib(%d) = %lld\n",k,array[k]);
    }
