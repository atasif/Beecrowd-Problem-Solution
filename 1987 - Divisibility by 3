#include<iostream>
using namespace std;

int main ()
{
    int n;
    long long int m;

    while (cin>>m>>n)
    {
        long long int sum=0;
        while (n>0)
        {
            sum+=n%10;
            n=n/10;
        }
        if (sum%3==0)
        {
            cout << sum << " sim"<< endl;
        }
        else  cout << sum << " nao"<< endl;
    }
    return 0;
}
