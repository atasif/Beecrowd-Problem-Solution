#include<stdio.h>
int main ()
{
    int a,x,y;
    scanf("%d",&a);
    for(int i=1;i<=a;i++)
    {
        scanf("%d%d",&x,&y);
         if (y!=0.0)
        {
            float  b=(float)x/(float)y;
            printf("%.1f\n",b);
        }
        else printf("divisao impossivel\n");
    }

    return 0;
}
