    if (a>b)
    {

        for(int i=b+1; i<a; i++)
        {
            if (i%2!=0)sum=sum+i;
        }
    }
    if (b>a)
    {

        for(int i=a+1; i<b; i++)
        {
            if (i%2!=0)sum=sum+i;
        }
    }
printf("%d\n",sum);
