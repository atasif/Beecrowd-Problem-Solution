#include<stdio.h>
int main ()
{

    float  a,b,c,d;
    scanf("%f%f%f%f",&a,&b,&c,&d);
    a=a*2.0;
    b=b*3.0;
    c=c*4.0;
    d=d*1.0;
    float ave=(a+b+c+d)/10.0;
    printf("Media: %.1f\n",ave);
    if (ave>=7.0)
    {
        printf("Aluno aprovado.\n");
    }
    else if (ave>=5.0&&ave<=6.9)
    {
        printf("Aluno em exame.\n");
        float f,aveg;
        scanf("%f",&f);
        printf("Nota do exame: %.1f\n",f);
        aveg=(ave+f)/2;
        if (aveg>=5.0)
        {
            printf("Aluno aprovado.\n");
        }
        else
        {
            printf("Aluno reprovado.\n");
        }
        printf("Media final: %.1f\n",aveg);
    }
    else if (ave<5.0)
    {
        printf("Aluno reprovado.\n");

    }

    return 0;
}
