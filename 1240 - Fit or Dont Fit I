#include<bits/stdc++.h>
using namespace std;
int main(){
    
    int t;
    cin>>t;
    while(t--){
        long long int k=0;
        string a,b;
        cin>>a>>b;
        if(a.size()<b.size()){
            cout<<"nao encaixa"<<endl;
            
        }
        else{
            for(int i=b.size()-1,j=a.size()-1;i>=0;i--,j--){
                if(a[j]==b[i]) k++;
            }
            if(k==b.size())cout<<"encaixa"<<endl;
            else cout<<"nao encaixa"<<endl;
        }
           
       }
    
    return 0;
}
