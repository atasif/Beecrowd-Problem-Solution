#include<stdio.h>
int main()
{
    int n,m,array[101][101];
    scanf("%d%d",&n,&m);
    for(int i=0; i<n; i++)
    {
        for (int j=0; j<m; j++)
        {
            scanf("%d",&array[i][j]);
        }

    }
    int semicount=0,count =0;
    for(int i=0; i<n; i++)
    {
        for (int j=0; j<m; j++)
        {
            if (array[i][j]>0)semicount++;
        }
        if (semicount==m)count++;
        semicount=0;
    }
    printf("%d\n",count);
    return 0;
}
