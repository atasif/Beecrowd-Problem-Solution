#include<stdio.h>
int main ()
{
    int a,b;
    int sum=0;
    scanf("%d%d",&a,&b);
    if(a>b)
    {
        for(int i=b; i<=a; i++)
        {
            if (i%13!=0)
            {
                sum=sum+i;
            }
        }
    }
     if(b>a)
    {
        for(int i=a; i<=b; i++)
        {
            if (i%13!=0)
            {
                sum=sum+i;
            }
        }
    }
    printf("%d\n",sum);
    return 0;
}
