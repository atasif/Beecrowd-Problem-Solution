#include <stdio.h>
#include<math.h>
int main() {
char c;
scanf("%c",&c);
double ch[12][12],sum=0;

for (int i=0;i<12;i++){
    for(int j=0;j<12;j++){
        scanf("%lf",&ch[i][j]);
        if (j>i)
        sum=sum+ch[i][j];
    }
}


if (c=='S' ) printf("%.1lf\n",sum);
else if (c=='M')printf("%.1lf\n",sum/66.0);

	return 0;
}
