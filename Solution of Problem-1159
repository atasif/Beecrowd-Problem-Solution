#include<bits/stdc++.h>
using namespace std;
int main(){
    long long int n;
    
    while(1){
        cin>>n;
      long long int result=0;
      if(n==0){ 
        break;
    }
      else if (n%2==0){
            for(int i=0;i<5;i++){
                result+=n;
                n+=2;
            }
            
        }
      else{
            for(int i=0;i<5;i++){
                result+=n;
                n+=2;
            }
            result+=5;  
        }  
        cout<<result<<endl;
    } 
    return 0;
}
