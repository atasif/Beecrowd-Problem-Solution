#include<stdio.h>
int main ()
{
    int a,b,temp,i;
    
    while(1)
    {int sum=0;
        scanf("%d%d",&a,&b);
        if(a<=0||b<=0) break;
        
        
         else   if(a>b)
            {
                temp=a;
                a=b;
                b=temp;
            }
            for( i=a; i<=b; i++)
            {
                sum=sum+i;
                printf("%d ",i);

            }
            printf("Sum=%d\n",sum);
        
    }

    return 0;
}
