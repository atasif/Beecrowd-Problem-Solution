#include <stdio.h>
 
int main() {
 int n,i,positive=0,neg=0,even=0,odd=0;
 for(i=1;i<=5;i++){
     scanf("%d",&n);
     if(n>0){positive++;}
     if(n<0){neg++;}
     if(n==0||n%2==0){even++;}
     if(n%2!=0){odd++;}
 }
 printf("%d valor(es) par(es)\n",even);
 printf("%d valor(es) impar(es)\n",odd);
 printf("%d valor(es) positivo(s)\n",positive);
 printf("%d valor(es) negativo(s)\n",neg);
    return 0;
}
