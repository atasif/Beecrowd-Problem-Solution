#include <stdio.h>
int main ()
{

    long long int i,j,m,n,fact1,fact2;
    while ((scanf ("%lld%lld",&m,&n))!=EOF)
    {
        fact1=1;fact2=1;

        for (i=m; i>=1; i--)
        {
            fact1*=i;
        }
        for (j=n; j>=1; j--)
        {
            fact2*=j;
        }

        printf("%lld\n",fact1+fact2);

    }

    return 0;
}
